# Journava — Caddy snippet for the shared /opt/reverse-proxy
#
# Add this block to /opt/reverse-proxy/Caddyfile, replacing <domain> with
# your actual domain (e.g. journava.example.com).
#
# The web container's Nginx already handles /api proxying internally,
# so Caddy only needs to reverse-proxy to the web service on port 8401.
#
# After adding this block:
#   cd /opt/reverse-proxy && docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile

journava.<domain> {
	reverse_proxy localhost:8401
}
