# Journava — Environment Variables
# Copy this file to the project root as .env and fill in your keys.
# NEVER commit the real .env to git.

# --------------------------------------------------------------------------- #
# Database (required for LLM providers, trip storage, agent events)
# --------------------------------------------------------------------------- #
POSTGRES_PASSWORD=change_me_to_a_strong_password

# --------------------------------------------------------------------------- #
# LLM Providers (set at least one; or configure via the /engine page at runtime)
# --------------------------------------------------------------------------- #
# Hero model — Alibaba DashScope (Qwen)
DASHSCOPE_API_KEY=
LLM_PRIMARY_MODEL=dashscope/qwen-max

# Fallback models (tried in order when primary fails)
# NOTE: Groq decommissioned all Llama models — use current ids (gpt-oss-*, qwen3.6-27b).
LLM_FALLBACK_MODELS=gemini/gemini-2.0-flash,groq/openai/gpt-oss-120b
GEMINI_API_KEY=
GROQ_API_KEY=

# General LLM settings
LLM_TEMPERATURE=0.4
LLM_TIMEOUT_SECONDS=30

# --------------------------------------------------------------------------- #
# Optional API keys (enhance agent output but not required for the demo)
# --------------------------------------------------------------------------- #
# Google Places (Research Agent — attractions, halal dining)
GOOGLE_PLACES_API_KEY=

# YouTube Data API v3 (Research Agent — video summaries)
YOUTUBE_API_KEY=

# Reddit API (Research Agent — subreddit sentiment)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Open-Meteo — no key needed (free, no auth)
# Frankfurter FX — no key needed (free, no auth)

# --------------------------------------------------------------------------- #
# App configuration
# --------------------------------------------------------------------------- #
APP_NAME=Journava
ENVIRONMENT=prod
DEBUG=false

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=https://journava.yourdomain.com,http://localhost:5173

# Redis (override if not using the compose redis service)
# REDIS_URL=redis://redis:6379/0

# Database (override if not using the compose postgres service)
# DATABASE_URL=postgresql://journava:password@postgres:5432/journava

# --------------------------------------------------------------------------- #
# Optional services (not in compose — run externally if needed)
# --------------------------------------------------------------------------- #
# Gnosion brain — library mode (in-process) is the default.
# To run as MCP service instead:
# GNOSION_MODE=mcp
# GNOSION_MCP_URL=http://gnosion:8500

# Camofox — browser research service (optional)
# CAMOFOX_URL=http://camofox:8501

# --------------------------------------------------------------------------- #
# API Vault encryption (recommended in production)
# --------------------------------------------------------------------------- #
# Encrypts every provider credential stored through the API Vault page.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key is derived from DATABASE_URL — which means rotating the database
# password would make every stored credential unreadable. Set it explicitly.
VAULT_ENCRYPTION_KEY=

# --------------------------------------------------------------------------- #
# Local model fallback (optional, no key required)
# --------------------------------------------------------------------------- #
# Tried only after every configured cloud provider fails. Journava probes the
# port first, so an absent Ollama costs milliseconds rather than seconds.
OLLAMA_FALLBACK_ENABLED=true
OLLAMA_FALLBACK_MODEL=ollama/llama3.2
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# --------------------------------------------------------------------------- #
# Provider keys now live in the API Vault, not here
# --------------------------------------------------------------------------- #
# Atlas, Amadeus, hotels, restaurants, maps, YouTube, Reddit and the rest are
# added through the API Vault page (Fernet-encrypted, tested before saving).
# The variables below still work as a fallback for an existing deployment, but
# the vault is the place to put a new key.
