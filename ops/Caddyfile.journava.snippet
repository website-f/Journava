# Journava — shared reverse-proxy registration (spec §13)
#
# The Journava stack is ONE public entry point: the `web` container serves the
# PWA and reverse-proxies /api/* (and the SSE stream) to `api` internally. So the
# proxy only needs to forward the domain to a single loopback port:
#
#     https://<JOURNAVA_DOMAIN>   ->   http://127.0.0.1:<JOURNAVA_WEB_PORT>   (default 8401)
#
# ── If your shared proxy is proxy-go / nginx ──────────────────────────────────
# Add a vhost that forwards the domain to 127.0.0.1:8401. That's the whole job —
# no path-splitting needed (nginx inside `web` already routes /api and streams
# SSE unbuffered). Example nginx server block:
#
#     server {
#         server_name journava.example.com;
#         location / {
#             proxy_pass http://127.0.0.1:8401;
#             proxy_http_version 1.1;
#             proxy_set_header Host $host;
#             proxy_set_header X-Real-IP $remote_addr;
#             proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#             proxy_set_header X-Forwarded-Proto $scheme;
#             proxy_buffering off;          # keep SSE (/api/v1/events) flowing
#             proxy_read_timeout 86400s;
#         }
#         # TLS handled by your shared proxy / certbot — do NOT terminate here.
#     }
#
# ── If your shared proxy is Caddy (/opt/reverse-proxy/Caddyfile) ──────────────
# Append the block below, replace the host, then reload:
#     docker compose -f /opt/reverse-proxy/docker-compose.yml \
#       exec caddy caddy reload --config /etc/caddy/Caddyfile
# (Caddy on the host network reaches the loopback port directly. If your Caddy
#  runs in a container instead, use host.docker.internal:8401.)

journava.example.com {
	encode zstd gzip

	reverse_proxy 127.0.0.1:8401 {
		# /api/v1/events is Server-Sent Events — never buffer it.
		flush_interval -1
		header_up X-Real-IP {remote_host}
	}

	header {
		Service-Worker-Allowed "/"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /var/log/caddy/journava.log
		format json
	}
}
